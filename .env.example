# Neon injects these into Vercel previews and production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/headlong

# Vercel deployments use OIDC for AI Gateway. Set this only off Vercel.
AI_GATEWAY_API_KEY=

# Kernel injects this for Headlong's browser execution capability.
KERNEL_API_KEY=

# Optional model overrides.
HEADLONG_MODEL=anthropic/claude-opus-4.8
HEADLONG_RECAP_MODEL=anthropic/claude-sonnet-4.6

# Optional external URL override for local or non-Vercel hosting.
HEADLONG_ORIGIN=http://localhost:3000
